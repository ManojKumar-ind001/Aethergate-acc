# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ENCRYPTION_MASTER_KEY: 32-byte hex or passphrase used to encrypt provider credentials at rest (AES-256-GCM).
ENCRYPTION_MASTER_KEY=

# GOOGLE OAUTH: Create OAuth 2.0 Web Client credentials in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GITHUB OAUTH: Create an OAuth App in GitHub Developer Settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AWS BASE CREDENTIALS: Optional IAM credentials used by server to call STS AssumeRole
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# DATABASE_URL: PostgreSQL connection string for production deployments (local dev uses SQLite automatically)
DATABASE_URL=
